<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <IsTrimmable Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsTrimmable>

    <Product>Atin</Product>
    <Title>Atin</Title>
    <Description>Alphanumeric Time Interval Notation (ATIN).</Description>
    <Authors>Jiri Kostiha</Authors>
    <Copyright>Copyright © 2024-2026 Jiri Kostiha</Copyright>
    <Version>1.1.0</Version>

    <RepositoryUrl>https://github.com/jirikostiha/atin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <PackageTags>time;timespan;interval;parser;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/jirikostiha/atin</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>

    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\ijkdata.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
