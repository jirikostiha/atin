<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>

    <Product>Atin</Product>
    <Title>Atin</Title>
    <Description>Alphanumeric Time Interval Notation (ATIN).</Description>
    <Authors>Jiri Kostiha</Authors>
    <Copyright>Copyright © 2024-2026 Jiri Kostiha</Copyright>
    <Version>1.1.3</Version>

    <RepositoryUrl>https://github.com/jirikostiha/atin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <PackageTags>time;timespan;interval;parser;csharp</PackageTags>
    <PackageProjectUrl>https://jirikostiha.github.io/atin/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>

    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\ijkdata.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
    <None Update="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>

</Project>
