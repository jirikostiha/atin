root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
end_of_line = lf

[*.{yml,yaml,json}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[*.{ps1,psm1}]
end_of_line = crlf

[*.cs]
end_of_line = crlf
